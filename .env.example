# =============================================================================
# Vokara — variables de entorno
# Copia este archivo a .env y rellena solo lo que uses.
# .env NUNCA se commitea. Este .env.example SI se commitea, con valores dummy.
# =============================================================================

# -----------------------------------------------------------------------------
# PROVEEDOR DE GENERACION (obligatorio)
# Configura al menos uno. Vokara usa el que elijas en el wizard.
# -----------------------------------------------------------------------------

# Google Gemini — sugerido por su capa gratuita. Llave: https://aistudio.google.com
GOOGLE_API_KEY=

# OpenAI — https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Anthropic — https://console.anthropic.com  (NO ofrece embeddings)
ANTHROPIC_API_KEY=

# DeepSeek — https://platform.deepseek.com
DEEPSEEK_API_KEY=

# Kimi / Moonshot — https://platform.moonshot.ai
MOONSHOT_API_KEY=

# -----------------------------------------------------------------------------
# OVERRIDE DE MODELOS (opcional)
# Los nombres de modelo cambian con frecuencia y los proveedores retiran los
# viejos. Si una llamada falla con 404, fija aqui un modelo vigente sin tocar
# codigo.
# -----------------------------------------------------------------------------

# VOKARA_GOOGLE_MODEL=gemini-3.6-flash
# VOKARA_GOOGLE_EMBED=models/gemini-embedding-001
# VOKARA_OPENAI_MODEL=gpt-4o-mini
# VOKARA_OPENAI_EMBED=text-embedding-3-small
# VOKARA_ANTHROPIC_MODEL=claude-sonnet-4-5-20250929
# VOKARA_DEEPSEEK_MODEL=deepseek-chat
# VOKARA_MOONSHOT_MODEL=kimi-k2-turbo-preview

# -----------------------------------------------------------------------------
# CORREO (opcional — ADR-012)
# Solo si quieres que Vokara lea tus alertas de empleo desde tu propio Gmail.
# Requiere verificacion en dos pasos activa y una App Password de 16 caracteres:
# https://myaccount.google.com/apppasswords
# No funciona en cuentas de Google Workspace ni con Proteccion Avanzada.
# -----------------------------------------------------------------------------

# GMAIL_ADDRESS=
# GMAIL_APP_PASSWORD=
# GMAIL_LABEL=Alertas de empleo

# -----------------------------------------------------------------------------
# INFRAESTRUCTURA LOCAL
# Valores por defecto del docker-compose. Cambialos solo si sabes por que.
# Los puertos se publican SOLO en 127.0.0.1 (ADR-008).
# -----------------------------------------------------------------------------

POSTGRES_USER=vokara
POSTGRES_PASSWORD=vokara_local_dev
POSTGRES_DB=vokara
DATABASE_URL=postgresql+psycopg://vokara:vokara_local_dev@postgres:5432/vokara
REDIS_URL=redis://redis:6379/0

# Directorio local donde se guardan los CVs originales (ADR-007).
# Los archivos quedan SIN CIFRAR: usa cifrado de disco del sistema operativo
# si necesitas esa proteccion.
VOKARA_STORAGE_PATH=./data/documents
